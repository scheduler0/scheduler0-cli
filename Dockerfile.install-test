FROM ubuntu:24.04

# Install minimal dependencies needed by install.sh
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /test

COPY install.sh ./
RUN chmod +x install.sh

# Run the install script.
# VERSION can be overridden at build time:  --build-arg VERSION=0.0.4
ARG VERSION=
ENV VERSION=${VERSION}

# /usr/local/bin is writable as root inside the container, no sudo needed.
RUN bash install.sh

# Smoke tests
RUN scheduler0 --version
RUN scheduler0 --help
